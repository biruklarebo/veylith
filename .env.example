# Copy to .env to override defaults. Read by Docker Compose.
FRONTEND_PORT=8088

BACKEND_PORT=8090
# Set to 0.0.0.0 to reach the backend from other devices on your network.
BACKEND_HOST=127.0.0.1
# Sites allowed to call the backend from a browser, comma separated.
BACKEND_ORIGINS=http://localhost:8088,http://localhost:5173
# Change, then run: ./stack.sh rebuild backend
POCKETBASE_VERSION=0.40.6
# Turns on "Continue with Google". Setup is in docs/backend.md. Then run: ./stack.sh start backend
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

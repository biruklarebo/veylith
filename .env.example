# Read by Docker Compose. stack.sh copies this to .env and fills in the empty secrets.
FRONTEND_PORT=8088

BACKEND_PORT=8090
# Set to 0.0.0.0 to reach the backend directly from other devices on your network.
BACKEND_HOST=127.0.0.1
# Signs sign-ins. Changing it signs everyone out.
JWT_SECRET=

# Change the version, then see docs/database.md: a new major version needs a backup and restore.
POSTGRES_VERSION=17
POSTGRES_DB=veylith
POSTGRES_USER=veylith
# Set when the database is first created. Changing it here later doesn't change the database.
POSTGRES_PASSWORD=
ADMINER_PORT=8091

# Turns on "Continue with Google". Setup is in docs/backend.md. Then run: ./stack.sh restart backend
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
